    <!-- Wake method selector -->
    <string name="wake_method_title">Wake method</string>
    <string name="shake_title">Shake</string>
    <string name="shake_subtitle">Shake to wake</string>
    <string name="shake_info">Wake the screen by deliberately shaking your phone. Adjust sensitivity to change how strong the movement needs to be.</string>

    <string name="lift_title">Lift</string>
    <string name="lift_subtitle">Pick up to wake</string>
    <string name="lift_info">Wake the screen by lifting your phone from rest, including from a screen-up position. Detection depends on movement strength and the device\'s sensors.</string>

    <!-- Shake sensitivity -->
    <string name="sens_title">Shake sensitivity</string>
    <string name="sens_title_value">Shake Sensitivity • about %1$.1f g</string>
    <string name="sens_end_low">Low · harder shake</string>
    <string name="sens_end_high">High · lighter shake</string>
    <string name="sens_cd">Shake sensitivity slider</string>
    <string name="sens_info">The slider moves the shake threshold between about 4.0 g at the left (low sensitivity, a hard shake is needed) and 1.8 g at the right (high sensitivity, a light shake is enough). 1 g is the pull of normal gravity. It only affects Shake to wake.</string>

    <!-- Lift sensitivity buttonlets -->
    <string name="lift_sens_title">Lift sensitivity</string>
    <string name="lift_gentle">Gentle</string>
    <string name="lift_firm">Firm</string>
    <string name="lift_sens_info">Choose how readily Lift responds to pickup movement. Gentle responds to lighter movements; Firm requires a more pronounced lift, preventing accidental wakes when simply picking up your phone without intending to use it.</string>

    <!-- Reach / Flip row -->
    <string name="reach_flip_title">Reach / Flip</string>
    <string name="reach_flip_subtitle">Retrieve from pocket or turn phone face-up</string>
    <string name="reach_flip_info">Wake the screen using supported proximity-cover transitions associated with retrieving or repositioning your phone. Exact behavior depends on the device\'s sensors.</string>

    <string name="adjust_cd">Adjust %1$s sensitivity</string>


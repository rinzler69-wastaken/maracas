<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="20dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/shake_action_dialog_title"
        android:textAppearance="@style/TextAppearance.Maracas.AppTitle"
        android:textSize="20sp" />

    <!-- Default (Wake screen) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnActionDefault"
        style="@style/Widget.Maracas.Card"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="10dp"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="25dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:id="@+id/ivIconDefault"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_power" />

            <TextView
                android:id="@+id/tvLabelDefault"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/action_default"
                android:textAppearance="@style/TextAppearance.Maracas.RowTitle"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivCheckDefault"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_check" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Flashlight -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnActionFlashlight"
        style="@style/Widget.Maracas.Card"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="10dp"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="25dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:id="@+id/ivIconFlashlight"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_flashlight" />

            <TextView
                android:id="@+id/tvLabelFlashlight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/action_flashlight"
                android:textAppearance="@style/TextAppearance.Maracas.RowTitle"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivCheckFlashlight"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_check" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
